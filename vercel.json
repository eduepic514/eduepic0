{
  "services": {
    "my_frontend": {
      "root": "frontend/",
      "framework": "react"  // or "nextjs", "vue", etc.
    },
    "my_backend": {
      "root": "backend/",
      "entrypoint": "server.js"  // or "main:app" for Python
    }
  },
  "rewrites": [
    { 
      "source": "/api/(.*)", 
      "destination": { "service": "my_backend" } 
    },
    { 
      "source": "/(.*)", 
      "destination": { "service": "my_frontend" } 
    }
  ]
}